{
  "name": "meta-automation-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/with-supabase-env.mjs pnpm next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:migrations": "vitest run tests/migrations",
    "test:integration:local": "node scripts/with-supabase-env.mjs pnpm vitest run tests/integration",
    "test:db": "supabase test db",
    "test:e2e": "node scripts/with-supabase-env.mjs pnpm playwright test",
    "test:e2e:auth": "node scripts/with-supabase-env.mjs pnpm playwright test tests/e2e/auth.spec.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "secret:scan": "secretlint \"**/*\"",
    "bundle:scan": "node scripts/check-client-bundle.mjs",
    "load:check": "node --check load/k6/panel.js && node --check load/k6/conversations.js",
    "production:preflight": "node scripts/production-preflight.mjs",
    "backup:local": "bash scripts/local-backup.sh",
    "meta:connect-test": "node --env-file=.env.local scripts/meta-connect-test-number.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm load:check && pnpm build && pnpm secret:scan"
  },
  "dependencies": {
    "@e965/xlsx": "0.20.3",
    "@marsidev/react-turnstile": "1.5.4",
    "@supabase/postgrest-js": "2.110.8",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "fflate": "0.8.2",
    "file-type": "21.3.2",
    "inngest": "4.13.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@electric-sql/pglite": "0.5.5",
    "@playwright/test": "1.62.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@types/emscripten": "1.41.5",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "secretlint": "13.0.4",
    "supabase": "2.110.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
