# Public application origin. Use a local URL for development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_PROVIDER=supabase
# Neon Preview uses these in encrypted host settings; leave blank for local Supabase.
NEON_AUTH_BASE_URL=
NEON_DATA_API_URL=
NEON_AUTH_COOKIE_SECRET=
APP_DEPLOYMENT_MODE=local
# Deployment control-plane gates; never expose to browser code.
VERCEL_COMMERCIAL_PLAN_CONFIRMED=false
PRODUCTION_DEPLOYMENT_APPROVED=false

# Server-only Supabase credentials. Replace placeholders outside Git.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Server-only Inngest credentials.
INNGEST_EVENT_KEY=replace-with-inngest-event-key
INNGEST_SIGNING_KEY=replace-with-inngest-signing-key

# Provider live operations remain disabled in Prompt 0.
LIVE_PROVIDER_SEND_ENABLED=false
LIVE_TEST_RECIPIENT_ALLOWLIST=

# Future server-only credential encryption key. Use 32 random bytes encoded as base64.
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-key

# Paid platform provider keys are server-only. BYOK values are never environment variables.
PLATFORM_AI_PROVIDER=gemini
PLATFORM_GEMINI_API_KEY=replace-with-paid-server-only-key
PLATFORM_OPENAI_API_KEY=replace-with-paid-server-only-key
PLATFORM_ANTHROPIC_API_KEY=replace-with-paid-server-only-key
AI_PROVIDER_TIMEOUT_MS=45000

# Model identifier per router role (src/modules/rcos/router.ts decides a role and
# deliberately names no model). Optional: an unconfigured role fails at the point
# of use naming the role, rather than blocking a deploy that never reaches it.
# The deterministic role is absent by design - it means "no model call at all".
AI_MODEL_UTILITY=
AI_MODEL_PRIMARY=
AI_MODEL_ESCALATION=
AI_MODEL_OFFLINE_EVALUATOR=

# Meta self-service connection and webhook configuration. Server-only except App ID.
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-server-only-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=replace-with-random-server-only-verification-token
META_OAUTH_REDIRECT_URL=http://localhost:3000/api/connections/meta/callback
META_GRAPH_API_VERSION=replace-with-current-reviewed-version
META_WHATSAPP_CONFIG_ID=replace-with-embedded-signup-config-id
META_CONNECTION_MODE=sandbox

# Authentication behavior and abuse protection.
ENABLE_EMAIL_CONFIRMATION=false
EMAIL_DELIVERY_VERIFIED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-public-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-server-only-turnstile-secret
AUTH_CAPTCHA_MODE=turnstile
AUTH_SIGNUP_MODE=invite_only
# Local developer sign-in bypass. Refused outside APP_DEPLOYMENT_MODE=local by
# proxy.ts, and a production build refuses to boot with it enabled.
AUTH_BYPASS_ENABLED=false
AUTH_BYPASS_EMAIL=
AUTH_BYPASS_PASSWORD=
PREVIEW_OWNER_EMAIL_ALLOWLIST=
AUTH_RATE_LIMIT_MODE=database
AUTH_RATE_LIMIT_HASH_KEY=replace-with-at-least-32-random-characters
AUTH_RATE_LIMIT_MAX_ATTEMPTS=8
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Required later for production password-reset delivery.
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-server-only-smtp-password
SMTP_FROM=replace-with-verified-sender

# CRM private media and export safety limits.
CRM_MEDIA_MAX_BYTES=10485760
CRM_EXPORT_MAX_ROWS=25000
CRM_EXPORT_MAX_FILES=1000
CRM_EXPORT_MAX_BYTES=104857600
CRM_EXPORT_TTL_SECONDS=900

# Billing: card-upfront trial gating and PayTR (server-only, fail-closed by default).
PAYMENT_PROVIDER_MODE=fake
PAYTR_MERCHANT_ID=replace-with-paytr-merchant-id
PAYTR_MERCHANT_KEY=replace-with-server-only-paytr-merchant-key
PAYTR_MERCHANT_SALT=replace-with-server-only-paytr-merchant-salt
LIVE_BILLING_ENABLED=false
BILLING_LIVE_APPROVED=false
BILLING_FINGERPRINT_HASH_KEY=replace-with-at-least-32-random-characters
BILLING_CALLBACK_STATE_SECRET=replace-with-at-least-32-random-characters
BILLING_TRIAL_DAYS=7
BILLING_PLAN_PRICE_MINOR_UNITS=49900
