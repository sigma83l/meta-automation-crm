# Public application origin. Use a local URL for development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Supabase credentials. Replace placeholders outside Git.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Server-only Inngest credentials.
INNGEST_EVENT_KEY=replace-with-inngest-event-key
INNGEST_SIGNING_KEY=replace-with-inngest-signing-key

# Provider live operations remain disabled in Prompt 0.
LIVE_PROVIDER_SEND_ENABLED=false
LIVE_TEST_RECIPIENT_ALLOWLIST=

# Future server-only credential encryption key. Use 32 random bytes encoded as base64.
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-key
